<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lê o modelo do painel (TMDL) com a biblioteca oficial do Power BI / Analysis Services (TOM)
       e grava o modelo em JSON (TMSL) para os testes conferirem nomes, medidas e relações. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.118.3" />
  </ItemGroup>
</Project>
