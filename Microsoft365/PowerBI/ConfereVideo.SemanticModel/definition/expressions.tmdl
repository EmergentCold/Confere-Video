/// Endereço do site do SharePoint (ex.: https://empresa.sharepoint.com/sites/Operacao). Com "exemplo", o painel usa os dados de exemplo.
expression SiteSharePoint = "exemplo" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	annotation PBI_ResultType = Text

/// Nome da lista de erros do ConfereVídeo.
expression ListaErros = "ConfereVideo_Erros" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	annotation PBI_ResultType = Text

/// Nome da lista de turnos do ConfereVídeo.
expression ListaTurnos = "ConfereVideo_Turnos" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	annotation PBI_ResultType = Text

/// Fuso horário das datas, em horas (Brasília: -3).
expression FusoHorario = -3 meta [IsParameterQuery = true, Type = "Number", IsParameterQueryRequired = true]

	annotation PBI_ResultType = Number

/// Mostrar também os itens que vieram da demonstração do programa.
expression IncluirDemonstracao = false meta [IsParameterQuery = true, Type = "Logical", IsParameterQueryRequired = true]

	annotation PBI_ResultType = Logical

/// Dados de exemplo (4 semanas, 3 postos, 2 turnos), usados quando SiteSharePoint = "exemplo".
expression DadosExemplo =
		let
		    Bruto = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
		    Tabela = (t as record) as table => Table.FromRows(t[rows], t[cols]),
		    Dados = [Erros = Tabela(Bruto[erros]), Turnos = Tabela(Bruto[turnos])]
		in
		    Dados

	annotation PBI_ResultType = Record
