model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SiteSharePoint", "ListaErros", "ListaTurnos", "FusoHorario", "IncluirDemonstracao", "DadosExemplo", "Erros", "Turnos", "PostoTurno", "Calendario", "Info", "Medidas"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Erros
ref table Turnos
ref table PostoTurno
ref table Calendario
ref table Info
ref table Medidas
